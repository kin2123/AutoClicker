<Window x:Class="AutoClickerPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="连点器 Pro" Width="372" Height="736"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Margin="16" CornerRadius="16" Background="{StaticResource BgBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.6" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="#101115" CornerRadius="16,16,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="10" Height="10" Margin="16,0,8,0"
                             Fill="{StaticResource AccentGradient}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="连点器 Pro" VerticalAlignment="Center"
                               FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextBrush}"/>
                    <ToggleButton x:Name="PinBtn" Grid.Column="2" Style="{StaticResource SegBtn}"
                                  Content="置顶" Margin="0,0,6,0" Click="PinBtn_Click"/>
                    <Button x:Name="MinBtn" Grid.Column="3" Style="{StaticResource TitleBtn}"
                            Content="—" Click="MinBtn_Click"/>
                    <Button x:Name="CloseBtn" Grid.Column="4" Style="{StaticResource TitleBtn}"
                            Content="✕" Margin="0,0,8,0" Click="CloseBtn_Click"/>
                </Grid>
            </Border>

            <!-- 主体 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12,16,0">
                <StackPanel>

                    <!-- 间隔 -->
                    <TextBlock Text="点击间隔（毫秒）" Style="{StaticResource Lbl}" Margin="2,0,0,6"/>
                    <TextBox x:Name="IntervalBox" Style="{StaticResource DarkBox}"
                             FontSize="26" FontWeight="Medium" HorizontalContentAlignment="Center"
                             Height="52" Text="100"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="随机浮动" Style="{StaticResource Lbl}" VerticalAlignment="Center"/>
                        <TextBox x:Name="JitterBox" Grid.Column="1" Style="{StaticResource DarkBox}"
                                 Width="70" HorizontalAlignment="Right" Text="0" TextAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="± %" Style="{StaticResource Lbl}"
                                   VerticalAlignment="Center" Margin="8,0,2,0"/>
                    </Grid>

                    <!-- 按键与模式 -->
                    <TextBlock Text="鼠标按键" Style="{StaticResource Lbl}" Margin="2,16,0,6"/>
                    <Border Background="#232630" CornerRadius="9" Padding="3">
                        <UniformGrid Columns="3">
                            <ToggleButton x:Name="BtnLeft"   Style="{StaticResource SegBtn}" Content="左键" IsChecked="True" Click="BtnSide_Click"/>
                            <ToggleButton x:Name="BtnRight"  Style="{StaticResource SegBtn}" Content="右键" Click="BtnSide_Click"/>
                            <ToggleButton x:Name="BtnMiddle" Style="{StaticResource SegBtn}" Content="中键" Click="BtnSide_Click"/>
                        </UniformGrid>
                    </Border>

                    <TextBlock Text="点击方式" Style="{StaticResource Lbl}" Margin="2,12,0,6"/>
                    <Border Background="#232630" CornerRadius="9" Padding="3">
                        <UniformGrid Columns="3">
                            <ToggleButton x:Name="ModeSingle" Style="{StaticResource SegBtn}" Content="单击" IsChecked="True" Click="ModeBtn_Click"/>
                            <ToggleButton x:Name="ModeDouble" Style="{StaticResource SegBtn}" Content="双击" Click="ModeBtn_Click"/>
                            <ToggleButton x:Name="ModeHold"   Style="{StaticResource SegBtn}" Content="按住" Click="ModeBtn_Click"/>
                        </UniformGrid>
                    </Border>

                    <StackPanel x:Name="HoldPanel" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                        <TextBlock Text="按住时长" Style="{StaticResource Lbl}" VerticalAlignment="Center"/>
                        <TextBox x:Name="HoldBox" Style="{StaticResource DarkBox}" Width="64" Text="200"
                                 TextAlignment="Center" Margin="10,0,6,0"/>
                        <TextBlock Text="毫秒" Style="{StaticResource Lbl}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 位置 -->
                    <TextBlock Text="点击位置" Style="{StaticResource Lbl}" Margin="2,16,0,6"/>
                    <Border Background="#232630" CornerRadius="9" Padding="3">
                        <UniformGrid Columns="3">
                            <ToggleButton x:Name="PosFollow" Style="{StaticResource SegBtn}" Content="跟随鼠标" IsChecked="True" Click="PosBtn_Click"/>
                            <ToggleButton x:Name="PosFixed"  Style="{StaticResource SegBtn}" Content="固定坐标" Click="PosBtn_Click"/>
                            <ToggleButton x:Name="PosMulti"  Style="{StaticResource SegBtn}" Content="多点循环" Click="PosBtn_Click"/>
                        </UniformGrid>
                    </Border>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PosInfo" Style="{StaticResource Lbl}" VerticalAlignment="Center"
                                   Text="跟随当前鼠标位置" TextTrimming="CharacterEllipsis"/>
                        <Button x:Name="PickBtn" Grid.Column="1" Style="{StaticResource GhostBtn}"
                                Content="拾取坐标" Visibility="Collapsed" Click="PickBtn_Click"/>
                        <Button x:Name="PointsBtn" Grid.Column="1" Style="{StaticResource GhostBtn}"
                                Content="坐标列表" Visibility="Collapsed" Click="PointsBtn_Click"/>
                    </Grid>

                    <!-- 限制 -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="点击次数（0 = 不限）" Style="{StaticResource Lbl}" Margin="2,0,0,6"/>
                            <TextBox x:Name="MaxCountBox" Style="{StaticResource DarkBox}" Text="0" TextAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="倒计时启动（秒）" Style="{StaticResource Lbl}" Margin="2,0,0,6"/>
                            <TextBox x:Name="CountdownBox" Style="{StaticResource DarkBox}" Text="0" TextAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- 启动 -->
                    <Button x:Name="StartBtn" Style="{StaticResource BigStart}" Margin="0,18,0,0"
                            Content="开始点击" Click="StartBtn_Click"/>

                    <!-- 热键 -->
                    <Grid Margin="0,12,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="全局热键" Style="{StaticResource Lbl}" VerticalAlignment="Center"/>
                        <Border x:Name="HotkeyChip" Grid.Column="2" Background="{StaticResource FieldBrush}"
                                CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                            <TextBlock x:Name="HotkeyText" Text="F6" FontSize="12"
                                       Foreground="{StaticResource TextBrush}"/>
                        </Border>
                        <Button x:Name="HotkeyBtn" Grid.Column="3" Style="{StaticResource GhostBtn}"
                                Content="更改热键" Click="HotkeyBtn_Click"/>
                    </Grid>

                </StackPanel>
            </ScrollViewer>

            <!-- 状态栏 -->
            <Border Grid.Row="2" Background="#101115" CornerRadius="0,0,16,16" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#5A5D66" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Grid.Column="1" Margin="10,0,0,0" FontSize="12"
                               Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"
                               Text="已停止"/>
                    <TextBlock x:Name="CountText" Grid.Column="2" FontSize="12" Foreground="{StaticResource TextDimBrush}"
                               VerticalAlignment="Center" Text=""/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
